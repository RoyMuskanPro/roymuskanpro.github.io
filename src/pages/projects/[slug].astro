---
import ProjectGallery from "../../components/ProjectGallery.astro";
import { projects, site, type Project } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
const pageTitle = `${project.title} | Power BI & SQL Case Study`;
const projectUrl = new URL(`/projects/${project.slug}/`, site.url).toString();
const projectImageUrl = new URL(project.coverImage.src.src, site.url).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${projectUrl}#case-study`,
      headline: project.title,
      description: project.seoDescription,
      url: projectUrl,
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": projectUrl,
      },
      image: {
        "@type": "ImageObject",
        url: projectImageUrl,
        width: project.coverImage.src.width,
        height: project.coverImage.src.height,
      },
      author: {
        "@type": "Person",
        "@id": `${site.url}/#person`,
        name: site.name,
        url: `${site.url}/`,
        sameAs: [site.social.linkedin, site.social.github],
      },
      publisher: { "@id": `${site.url}/#person` },
      articleSection: "Data analytics case studies",
      about: project.tools.map((tool) => ({ "@type": "Thing", name: tool })),
      isAccessibleForFree: true,
      inLanguage: "en-IN",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${projectUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Portfolio",
          item: `${site.url}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: project.title,
          item: projectUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={project.seoDescription}
  path={`/projects/${project.slug}/`}
  image={project.coverImage.src}
  imageAlt={project.coverImage.alt}
  pageType="article"
  structuredData={structuredData}
>
  <article class="case-study">
    <header class="case-hero shell">
      <a class="back-link" href="/#work"><span aria-hidden="true">←</span> All projects</a>
      <div class="case-title-grid">
        <div class="reveal is-visible">
          <p class="eyebrow">{project.eyebrow}</p>
          <h1>{project.title}</h1>
        </div>
        <div class="case-deck-wrap reveal is-visible">
          <p class="case-deck">{project.shortDescription}</p>
          <div class="case-report-action">
            <a class="button button-primary case-report-link" href="#interactive-dashboard">
              Explore the report <span aria-hidden="true">↓</span>
            </a>
            <p>Browse the preview below, then read about the data, methods, and findings.</p>
          </div>
          <ul class="case-stack" aria-label="Tools used">
            {project.tools.slice(0, 4).map((tool) => <li>{tool}</li>)}
          </ul>
        </div>
      </div>
      <dl class="case-metrics" aria-label="Selected project metrics">
        {project.metrics.map((metric) => (
          <div>
            <dt>{metric.label}</dt>
            <dd>{metric.value}</dd>
            {metric.note && <p>{metric.note}</p>}
          </div>
        ))}
      </dl>
    </header>

    <section class="dashboard-section dashboard-section-featured" aria-labelledby="dashboard-title">
      <div class="shell dashboard-heading reveal nav-target" id="interactive-dashboard">
        <div>
          <p class="eyebrow">Interactive preview</p>
          <h2 id="dashboard-title">Explore the report</h2>
        </div>
        <p>{project.interactiveReport.instruction}</p>
      </div>
      <div class="shell report-frame-shell reveal">
        <div class="report-toolbar">
          <div>
            <span class="report-status" aria-hidden="true"></span>
            <p>Report preview</p>
          </div>
          <a href={project.interactiveReport.url} target="_blank" rel="noreferrer">
            Open in new tab <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="report-frame" style={`--report-ratio: ${project.interactiveReport.aspectRatio}`}>
          <iframe
            src={project.interactiveReport.url}
            title={project.interactiveReport.title}
            loading="eager"
            sandbox="allow-scripts"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </div>
      <div class="shell gallery-heading reveal">
        <div>
          <p class="eyebrow">Screenshots</p>
          <h3>Power BI report pages</h3>
        </div>
        <p>These screenshots show the original Power BI pages. Select an image to enlarge it and read the charts, tables, and measures in more detail.</p>
      </div>
      <div class="gallery-shell">
        <ProjectGallery images={project.images} />
      </div>
    </section>

    <section class="case-section shell" aria-labelledby="overview-title">
      <div class="case-section-label"><p>Project context</p></div>
      <div class="case-section-body">
        <h2 id="overview-title">What I set out to examine</h2>
        <div class="overview-copy">
          {project.overview.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <blockquote>
          <span>Reporting question</span>
          <p>{project.question}</p>
        </blockquote>
        <div class="dataset-note">
          <h3>Dataset and scope</h3>
          <p>{project.dataset}</p>
          {project.sourceUrl && project.sourceLabel && (
            <a class="text-link" href={project.sourceUrl} target="_blank" rel="noreferrer">
              View the {project.sourceLabel} <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="case-section shell" aria-labelledby="method-title">
      <div class="case-section-label"><p>Approach</p></div>
      <div class="case-section-body">
        <h2 id="method-title">How I prepared and analysed the data</h2>
        <ol class="method-list">
          {project.method.map((step) => (
            <li class="reveal">
              <span>{step.label}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="case-section shell" aria-labelledby="insights-title">
      <div class="case-section-label"><p>Findings</p></div>
      <div class="case-section-body">
        <h2 id="insights-title">What the data shows</h2>
        <ol class="insight-list">
          {project.insights.map((insight, index) => (
            <li class="reveal"><span>0{index + 1}</span><p>{insight}</p></li>
          ))}
        </ol>
        <div class="limitations reveal">
          <h3>Limits and assumptions</h3>
          <ul>
            {project.limitations.map((limitation) => <li>{limitation}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="case-links shell" aria-label="Project links">
      <div>
        <p class="eyebrow">Working files</p>
        <h2>Queries, model notes, and project documentation.</h2>
      </div>
      <a class="button button-primary" href={project.githubUrl} target="_blank" rel="noreferrer">
        View GitHub repository <span aria-hidden="true">↗</span>
      </a>
    </section>

    <aside class="next-project">
      <a class="shell" href={`/projects/${nextProject.slug}/`}>
        <span>
          <small>Next case study</small>
          {nextProject.title}
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </article>
</BaseLayout>
