---
import type { ProjectImage } from "../data/site";
import ResponsivePicture from "./ResponsivePicture.astro";

interface Props {
  images: ProjectImage[];
}

const { images } = Astro.props;
---

<div class="project-gallery">
  {images.map((image, index) => (
    <figure class="gallery-item reveal">
      <a
        class="gallery-open"
        href={image.src.src}
        data-lightbox
        data-caption={image.caption}
        aria-label={`Enlarge report screenshot ${index + 1} of ${images.length}`}
      >
        <ResponsivePicture
          src={image.src}
          alt={image.alt}
          widths={[320, 480, 720, 960]}
          sizes="(max-width: 620px) 94vw, (max-width: 800px) 46vw, 24vw"
          quality={84}
        />
        <span class="expand-hint" aria-hidden="true">View larger</span>
      </a>
      <figcaption>{image.caption}</figcaption>
    </figure>
  ))}
</div>

<dialog class="image-dialog" aria-labelledby="dialog-caption">
  <div class="dialog-toolbar">
    <p id="dialog-caption"></p>
    <button class="dialog-close" type="button" aria-label="Close report screenshot">Close</button>
  </div>
  <div class="dialog-stage">
    <button class="dialog-nav dialog-previous" type="button" aria-label="View previous screenshot">
      <span aria-hidden="true">←</span>
    </button>
    <img src="" alt="" />
    <button class="dialog-nav dialog-next" type="button" aria-label="View next screenshot">
      <span aria-hidden="true">→</span>
    </button>
  </div>
</dialog>
