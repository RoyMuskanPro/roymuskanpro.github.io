---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  widths?: number[];
  sizes?: string;
  quality?: number;
}

const {
  src,
  alt,
  class: className,
  loading = "lazy",
  widths = [480, 720, 960, 1440, src.width],
  sizes = "(max-width: 760px) 94vw, (max-width: 1200px) 88vw, 1120px",
  quality = 86,
} = Astro.props;

const availableWidths = [...new Set(widths.filter((width) => width <= src.width))].sort((a, b) => a - b);
---

<Image
  src={src}
  widths={availableWidths}
  sizes={sizes}
  alt={alt}
  class={className}
  loading={loading}
  decoding="async"
  quality={quality}
  format="webp"
  fit="cover"
/>
