---
import type { Project } from "../data/site";
import ResponsivePicture from "./ResponsivePicture.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card reveal">
  <a class="project-image-link" href={`/projects/${project.slug}/`} aria-label={`View the ${project.title} case study`}>
    <ResponsivePicture
      src={project.coverImage.src}
      alt={project.coverImage.alt}
      widths={[480, 720, 960, 1440, 1920, project.coverImage.src.width]}
      sizes="(max-width: 760px) 94vw, (max-width: 1100px) 44vw, 600px"
      quality={88}
    />
  </a>
  <div class="project-copy">
    <p class="eyebrow">{project.eyebrow}</p>
    <h3><a href={`/projects/${project.slug}/`}>{project.title}</a></h3>
    <p>{project.shortDescription}</p>
    <a
      class="project-report-preview"
      href={`/projects/${project.slug}/#interactive-dashboard`}
      aria-label={`View the ${project.title} report preview`}
    >
      <span>Interactive preview</span>
      <strong>Explore the report <span aria-hidden="true">↗</span></strong>
    </a>
    <dl class="project-card-metrics" aria-label="Selected project metrics">
      {project.metrics.slice(0, 3).map((metric) => (
        <div>
          <dt>{metric.label}</dt>
          <dd>{metric.value}</dd>
        </div>
      ))}
    </dl>
    <ul class="tag-list" aria-label="Tools used">
      {project.tools.slice(0, 3).map((tool) => <li>{tool}</li>)}
    </ul>
    <a class="text-link" href={`/projects/${project.slug}/`}>
      View case study <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
